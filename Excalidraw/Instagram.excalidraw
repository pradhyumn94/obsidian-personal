      "link": null,
      "locked": false,
      "text": "\n\n\nGET /feed?limit={pageSize}&from={cursor} -------------> posts[]\n\n\nPOST /posts ----------------------------------------> postId\n{\n  \"media\": mediaUploadId, // uploaded directly using presigned-uploads\n  \"caption\": \"My cool photo!\",\n}",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\n\nGET /feed?limit={pageSize}&from={cursor} -------------> posts[]\n\n\nPOST /posts ----------------------------------------> postId\n{\n  \"media\": mediaUploadId, // uploaded directly using presigned-uploads\n  \"caption\": \"My cool photo!\",\n}",
      "autoResize": true,
      "lineHeight": 1.2
    },
